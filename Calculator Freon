<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator Kebutuhan Freon AC</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; }
        @media print {
            body * { visibility: hidden; }
            #print-area, #print-area * { visibility: visible; }
            #print-area { position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 20px; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col">

    <header class="bg-slate-900 border-b border-slate-800 text-white shadow-md no-print">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center">
            <div class="flex items-center space-x-3 mb-2 md:mb-0">
                <div class="bg-blue-600 text-white p-2 rounded-xl shadow">
                    <i class="fa-solid fa-snowflake text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold">Kalkulator Kebutuhan Freon AC</h1>
                    <p class="text-xs text-slate-400">Modul Perhitungan Profesional Standar Lapangan (DX & VRV)</p>
                </div>
            </div>
            <div class="flex items-center space-x-2">
                <span id="current-date-badge" class="bg-slate-800 text-slate-300 border border-slate-700 text-xs px-3 py-1.5 rounded-full font-medium"></span>
            </div>
        </div>
    </header>

    <main class="flex-grow max-w-7xl w-full mx-auto px-4 py-6 grid grid-cols-1 lg:grid-cols-12 gap-6">
        
        <!-- FORM INPUT SECTION -->
        <section class="lg:col-span-5 bg-slate-900 rounded-2xl shadow-sm border border-slate-800 p-6 no-print">
            <div class="flex items-center justify-between mb-6 pb-3 border-b border-slate-800">
                <h2 class="text-lg font-bold text-slate-100 flex items-center gap-2">
                    <i class="fa-solid fa-file-pen text-blue-500"></i> Data Entry Proyek
                </h2>
                <button type="button" id="btn-reset" class="text-xs text-rose-400 hover:text-rose-300 font-medium flex items-center gap-1 transition">
                    <i class="fa-solid fa-rotate-right"></i> Reset Form
                </button>
            </div>

            <form id="calc-form" class="space-y-4">
                <!-- Nama Teknisi -->
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Nama Teknisi</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500"><i class="fa-solid fa-user"></i></span>
                        <input type="text" id="technician-name" required placeholder="Contoh: Hasby Khairul Lifie" class="w-full pl-10 pr-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-slate-900 transition">
                    </div>
                </div>

                <!-- Nama Proyek -->
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Nama Proyek / Lokasi</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500"><i class="fa-solid fa-building"></i></span>
                        <input type="text" id="project-name" required placeholder="Contoh: Gedung Menara Lt. 3" class="w-full pl-10 pr-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-slate-900 transition">
                    </div>
                </div>

                <!-- Tanggal Pengisian -->
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Tanggal Pengisian</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500"><i class="fa-solid fa-calendar"></i></span>
                        <input type="date" id="refill-date" required class="w-full pl-10 pr-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-slate-900 transition">
                    </div>
                </div>

                <!-- Sistem AC (DX / VRV) -->
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Sistem AC</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="cursor-pointer border border-slate-700 bg-slate-800/50 rounded-xl p-3 flex items-center space-x-3 hover:border-blue-500 transition system-option">
                            <input type="radio" name="ac-system" value="DX" checked class="text-blue-600 focus:ring-blue-500 bg-slate-800 border-slate-600">
                            <div>
                                <span class="block text-sm font-bold text-slate-200">Sistem DX</span>
                                <span class="block text-xs text-slate-400">Split / Cassette</span>
                            </div>
                        </label>
                        <label class="cursor-pointer border border-slate-700 bg-slate-800/50 rounded-xl p-3 flex items-center space-x-3 hover:border-blue-500 transition system-option">
                            <input type="radio" name="ac-system" value="VRV" class="text-blue-600 focus:ring-blue-500 bg-slate-800 border-slate-600">
                            <div>
                                <span class="block text-sm font-bold text-slate-200">Sistem VRV</span>
                                <span class="block text-xs text-slate-400">Multi-Split Central</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Panjang Pipa -->
                <div>
                    <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Panjang Pipa Total (Meter)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500"><i class="fa-solid fa-ruler"></i></span>
                        <input type="number" id="pipe-length" min="0" step="0.5" required placeholder="Contoh: 15" class="w-full pl-10 pr-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-slate-900 transition">
                    </div>
                </div>

                <!-- Pengelompokan VRV (Conditional) -->
                <div id="vrv-group-container" class="hidden space-y-4 pt-2 border-t border-slate-800">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Pengelompokan / Ukuran Pipa Utama VRV</label>
                        <select id="vrv-group" class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-slate-900 transition">
                            <option value="small">Kecil (Cairan &lt; 9.5 mm / 3/8") - Standar 0.022 kg/m</option>
                            <option value="medium" selected>Sedang (Cairan 9.5 - 12.7 mm) - Standar 0.054 kg/m</option>
                            <option value="large">Besar (Cairan &gt; 15.9 mm) - Standar 0.110 kg/m</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Jumlah Unit Indoor Terhubung</label>
                        <input type="number" id="vrv-indoor-count" min="1" value="4" class="w-full px-4 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-slate-900 transition">
                    </div>
                </div>

                <!-- Kapasitas Tambahan / Tambahan Jenis Freon -->
                <div class="grid grid-cols-2 gap-3 pt-2">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Tipe Refrigerant</label>
                        <select id="refrigerant-type" class="w-full px-3 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-slate-900 transition">
                            <option value="R410A">R-410A</option>
                            <option value="R32">R-32</option>
                            <option value="R22">R-22</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1">Pipa Standar Pabrik (m)</label>
                        <input type="number" id="factory-pipe-standard" min="0" value="7.5" step="0.5" class="w-full px-3 py-2.5 bg-slate-800 border border-slate-700 rounded-xl text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-slate-900 transition">
                    </div>
                </div>

                <!-- Submit Action -->
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-3 px-4 rounded-xl shadow-md transition duration-200 flex items-center justify-center gap-2 mt-4">
                    <i class="fa-solid fa-calculator"></i> Hitung & Simpan Data
                </button>
            </form>
        </section>

        <!-- DASHBOARD & RESULTS SECTION -->
        <section class="lg:col-span-7 flex flex-col space-y-6">
            
            <!-- REALTIME CALCULATION RESULT CARD -->
            <div class="bg-slate-900 rounded-2xl shadow-sm border border-slate-800 p-6">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
                    <h2 class="text-lg font-bold text-slate-100 flex items-center gap-2">
                        <i class="fa-solid fa-chart-pie text-emerald-400"></i> Hasil Perhitungan Real-Time
                    </h2>
                    <span id="active-system-tag" class="bg-blue-950 text-blue-300 border border-blue-800 font-bold text-xs px-3 py-1 rounded-full uppercase">Sistem DX</span>
                </div>

                <!-- Stat Grid -->
                <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-6">
                    <div class="bg-slate-800/60 p-4 rounded-xl border border-slate-700/50">
                        <span class="block text-xs text-slate-400 font-medium">Panjang Pipa Efektif</span>
                        <span id="res-effective-pipe" class="text-xl font-extrabold text-slate-100">0.0 m</span>
                    </div>
                    <div class="bg-slate-800/60 p-4 rounded-xl border border-slate-700/50">
                        <span class="block text-xs text-slate-400 font-medium">Koreksi Pipa (&gt;Std)</span>
                        <span id="res-pipe-diff" class="text-xl font-extrabold text-slate-100">0.0 m</span>
                    </div>
                    <div class="col-span-2 md:col-span-1 bg-emerald-950/40 p-4 rounded-xl border border-emerald-900/50">
                        <span class="block text-xs text-emerald-400 font-medium">Total Kebutuhan Freon</span>
                        <span id="res-total-freon" class="text-2xl font-black text-emerald-400">0.00 kg</span>
                    </div>
                </div>

                <!-- Breakdown detail -->
                <div class="bg-slate-800/40 rounded-xl p-4 border border-slate-800 mb-6 space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-slate-400">Faktor Penambahan / Meter:</span>
                        <span id="res-factor" class="font-semibold text-slate-200">0.020 kg/m</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-slate-400">Estimasi Tabung Tabung (3kg / 10kg):</span>
                        <span id="res-canister" class="font-semibold text-blue-400">-</span>
                    </div>
                </div>

                <!-- Action Toolbar -->
                <div class="flex flex-wrap gap-3">
                    <button type="button" id="btn-print-requisition" class="flex-1 bg-slate-800 hover:bg-slate-700 text-white font-semibold py-2.5 px-4 rounded-xl text-sm transition flex items-center justify-center gap-2 shadow-sm border border-slate-700">
                        <i class="fa-solid fa-print"></i> Cetak Laporan (pdf)
                    </button>
                    <button type="button" id="btn-export-csv" class="bg-emerald-700 hover:bg-emerald-600 text-white font-semibold py-2.5 px-4 rounded-xl text-sm transition flex items-center justify-center gap-2 shadow-sm">
                        <i class="fa-solid fa-file-excel"></i> Export CSV
                    </button>
                </div>
            </div>

            <!-- SAVED DATA LOGS TABLE -->
            <div class="bg-slate-900 rounded-2xl shadow-sm border border-slate-800 p-6 flex-grow flex flex-col">
                <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-800">
                    <h2 class="text-lg font-bold text-slate-100 flex items-center gap-2">
                        <i class="fa-solid fa-database text-blue-500"></i> Riwayat & Manajemen Data
                    </h2>
                    <span id="record-count" class="bg-slate-800 text-slate-300 text-xs px-2.5 py-1 rounded-full font-semibold border border-slate-700">0 data</span>
                </div>

                <div class="overflow-x-auto flex-grow">
                    <table class="w-full text-left border-collapse text-sm">
                        <thead>
                            <tr class="border-b border-slate-800 text-xs text-slate-400 uppercase tracking-wider">
                                <th class="py-3 px-2">Proyek / Teknisi</th>
                                <th class="py-3 px-2">Sistem</th>
                                <th class="py-3 px-2">Pipa</th>
                                <th class="py-3 px-2">Total Freon</th>
                                <th class="py-3 px-2 text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="logs-table-body">
                            <!-- Populated via Javascript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

    </main>

    <!-- FOOTER COPYRIGHT SECTION -->
    <footer class="bg-slate-900 border-t border-slate-800 mt-auto py-4 no-print text-slate-400">
        <div class="max-w-7xl mx-auto px-4 text-center text-xs font-medium">
            &copy; Mas By - 2026. Hak Cipta Dilindungi Undang-Undang. Dibangun untuk Profesional HVAC &amp; Teknisi Lapangan.
        </div>
    </footer>

    <!-- PRINTABLE REQUISITION TEMPLATE (BON PERMINTAAN BARANG) -->
    <div id="print-area" class="hidden bg-white p-8 max-w-3xl mx-auto text-slate-800">
        <div class="border-b-2 border-slate-800 pb-4 mb-6 flex justify-between items-end">
            <div>
                <h1 class="text-2xl font-black uppercase tracking-wider">Bon Permintaan Barang</h1>
                <p class="text-xs text-slate-500">Formulir Permohonan Material Refrigerant & Instalasi AC</p>
            </div>
            <div class="text-right">
                <span class="block text-xs font-bold text-slate-400 uppercase">No. Dokumen</span>
                <span id="print-doc-id" class="text-sm font-bold text-slate-800">REQ-2026-001</span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mb-6 text-sm bg-slate-50 p-4 rounded-xl border border-slate-200">
            <div>
                <span class="block text-xs font-semibold text-slate-500 uppercase">Nama Teknisi:</span>
                <span id="print-technician" class="font-bold text-slate-800">-</span>
            </div>
            <div>
                <span class="block text-xs font-semibold text-slate-500 uppercase">Nama Proyek:</span>
                <span id="print-project" class="font-bold text-slate-800">-</span>
            </div>
            <div>
                <span class="block text-xs font-semibold text-slate-500 uppercase">Tanggal Pengisian:</span>
                <span id="print-date" class="font-bold text-slate-800">-</span>
            </div>
            <div>
                <span class="block text-xs font-semibold text-slate-500 uppercase">Sistem & Tipe Freon:</span>
                <span id="print-system-info" class="font-bold text-slate-800">-</span>
            </div>
        </div>

        <table class="w-full text-left border border-slate-300 mb-8 text-sm">
            <thead>
                <tr class="bg-slate-100 border-b border-slate-300">
                    <th class="p-3 border-r border-slate-300">No.</th>
                    <th class="p-3 border-r border-slate-300">Deskripsi Material / Item</th>
                    <th class="p-3 border-r border-slate-300 text-center">Qty</th>
                    <th class="p-3 text-center">Satuan</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b border-slate-200">
                    <td class="p-3 border-r border-slate-300 text-center">1</td>
                    <td id="print-item-name" class="p-3 border-r border-slate-300 font-medium">Refrigerant R-410A</td>
                    <td id="print-item-qty" class="p-3 border-r border-slate-300 text-center font-bold">0.00</td>
                    <td class="p-3 text-center">Kg</td>
                </tr>
                <tr class="border-b border-slate-200">
                    <td class="p-3 border-r border-slate-300 text-center">2</td>
                    <td class="p-3 border-r border-slate-300 font-medium">Nitrogen Gas (Purging/Testing)</td>
                    <td class="p-3 border-r border-slate-300 text-center">1</td>
                    <td class="p-3 text-center">Tabung</td>
                </tr>
                <tr>
                    <td class="p-3 border-r border-slate-300 text-center">3</td>
                    <td class="p-3 border-r border-slate-300 font-medium">Material Isolasi / Pipa Pendukung</td>
                    <td class="p-3 border-r border-slate-300 text-center">1</td>
                    <td class="p-3 text-center">Lot</td>
                </tr>
            </tbody>
        </table>

        <div class="grid grid-cols-3 gap-6 text-center text-xs mt-12 pt-8">
            <div class="space-y-16">
                <span class="font-semibold block text-slate-600">Diajukan Oleh (Teknisi)</span>
                <span id="sign-tech" class="block font-bold text-slate-800 border-t border-slate-400 pt-1">( - )</span>
            </div>
            <div class="space-y-16">
                <span class="font-semibold block text-slate-600">Disetujui Oleh (Supervisor)</span>
                <span class="block font-bold text-slate-800 border-t border-slate-400 pt-1">( ........................ )</span>
            </div>
            <div class="space-y-16">
                <span class="font-semibold block text-slate-600">Diserahkan Oleh (Gudang)</span>
                <span class="block font-bold text-slate-800 border-t border-slate-400 pt-1">( ........................ )</span>
            </div>
        </div>
    </div>

    <!-- NOTIFICATION MODAL CUSTOM -->
    <div id="notification-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 max-w-sm w-full mx-4 shadow-xl text-center space-y-4">
            <div id="modal-icon" class="w-12 h-12 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 mx-auto flex items-center justify-center text-xl font-bold">
                <i class="fa-solid fa-check"></i>
            </div>
            <h3 id="modal-title" class="text-lg font-bold text-slate-100">Berhasil</h3>
            <p id="modal-message" class="text-sm text-slate-400">Pesan konfirmasi sistem...</p>
            <button type="button" id="modal-close-btn" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-2.5 rounded-xl text-sm transition">Tutup</button>
        </div>
    </div>

    <script>
        let calculationRecords = JSON.parse(localStorage.getItem('ac_calc_records')) || [];

        // Set default date to today
        document.getElementById('refill-date').valueAsDate = new Date();
        const optionsDate = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
        document.getElementById('current-date-badge').innerText = new Date().toLocaleDateString('id-ID', optionsDate);

        const form = document.getElementById('calc-form');
        const systemRadios = document.querySelectorAll('input[name="ac-system"]');
        const vrvGroupContainer = document.getElementById('vrv-group-container');
        const activeSystemTag = document.getElementById('active-system-tag');

        // Toggle VRV grouping elements
        systemRadios.forEach(radio => {
            radio.addEventListener('change', (e) => {
                if(e.target.value === 'VRV') {
                    vrvGroupContainer.classList.remove('hidden');
                    activeSystemTag.innerText = 'Sistem VRV';
                    activeSystemTag.className = 'bg-purple-950 text-purple-300 border border-purple-800 font-bold text-xs px-3 py-1 rounded-full uppercase';
                } else {
                    vrvGroupContainer.classList.add('hidden');
                    activeSystemTag.innerText = 'Sistem DX';
                    activeSystemTag.className = 'bg-blue-950 text-blue-300 border border-blue-800 font-bold text-xs px-3 py-1 rounded-full uppercase';
                }
                calculateRealtime();
            });
        });

        const techInput = document.getElementById('technician-name');
        const projectInput = document.getElementById('project-name');
        const dateInput = document.getElementById('refill-date');
        const pipeLengthInput = document.getElementById('pipe-length');
        const factoryPipeInput = document.getElementById('factory-pipe-standard');
        const refrigerantSelect = document.getElementById('refrigerant-type');
        const vrvGroupSelect = document.getElementById('vrv-group');
        const vrvIndoorInput = document.getElementById('vrv-indoor-count');

        // Live calculation triggers
        [pipeLengthInput, factoryPipeInput, refrigerantSelect, vrvGroupSelect, vrvIndoorInput].forEach(element => {
            element.addEventListener('input', calculateRealtime);
            element.addEventListener('change', calculateRealtime);
        });

        function calculateRealtime() {
            const systemType = document.querySelector('input[name="ac-system"]:checked').value;
            const pipeLength = parseFloat(pipeLengthInput.value) || 0;
            const factoryStd = parseFloat(factoryPipeInput.value) || 0;
            const effectivePipe = Math.max(0, pipeLength - factoryStd);
            
            let factor = 0.020; // Default DX factor per meter
            if(systemType === 'VRV') {
                const group = vrvGroupSelect.value;
                if(group === 'small') factor = 0.022;
                else if(group === 'medium') factor = 0.054;
                else if(group === 'large') factor = 0.110;
            } else {
                // Adjust factor based on refrigerant type for DX
                const ref = refrigerantSelect.value;
                if(ref === 'R410A') factor = 0.030;
                else if(ref === 'R32') factor = 0.020;
                else if(ref === 'R22') factor = 0.050;
            }

            const totalFreon = effectivePipe * factor;

            // Update UI Stats
            document.getElementById('res-effective-pipe').innerText = pipeLength.toFixed(1) + ' m';
            document.getElementById('res-pipe-diff').innerText = effectivePipe.toFixed(1) + ' m';
            document.getElementById('res-total-freon').innerText = totalFreon.toFixed(2) + ' kg';
            document.getElementById('res-factor').innerText = factor.toFixed(3) + ' kg/m (' + systemType + ')';
            
            let canisterEst = '-';
            if(totalFreon > 0) {
                const tabung3kg = Math.ceil(totalFreon / 3);
                const tabung10kg = (totalFreon / 10).toFixed(1);
                canisterEst = `~ ${tabung3kg} Tabung (3kg) atau ${tabung10kg} Tabung (10kg)`;
            }
            document.getElementById('res-canister').innerText = canisterEst;

            return { systemType, pipeLength, effectivePipe, factor, totalFreon };
        }

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const calc = calculateRealtime();

            const record = {
                id: 'REC-' + Date.now().toString().slice(-6),
                technician: techInput.value,
                project: projectInput.value,
                date: dateInput.value,
                system: calc.systemType,
                pipeLength: calc.pipeLength,
                refrigerant: refrigerantSelect.value,
                totalFreon: calc.totalFreon.toFixed(2),
                timestamp: new Date().toLocaleString('id-ID')
            };

            calculationRecords.unshift(record);
            localStorage.setItem('ac_calc_records', JSON.stringify(calculationRecords));
            renderLogs();
            showModal('Berhasil Tersimpan', 'Data perhitungan proyek berhasil dimasukkan ke dalam basis data sistem.');
        });

        function renderLogs() {
            const tbody = document.getElementById('logs-table-body');
            const countBadge = document.getElementById('record-count');
            countBadge.innerText = `${calculationRecords.length} data`;

            if(calculationRecords.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-slate-500 italic">Belum ada data perhitungan tersimpan.</td></tr>`;
                return;
            }

            tbody.innerHTML = '';
            calculationRecords.forEach((rec, index) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-800/50 transition border-b border-slate-800 last:border-none';
                tr.innerHTML = `
                    <td class="py-3 px-2">
                        <span class="font-bold block text-slate-200">${rec.project}</span>
                        <span class="text-xs text-slate-400"><i class="fa-solid fa-user text-slate-500 mr-1"></i>${rec.technician}</span>
                    </td>
                    <td class="py-3 px-2">
                        <span class="px-2 py-0.5 rounded text-xs font-semibold ${rec.system === 'VRV' ? 'bg-purple-950 text-purple-300 border border-purple-800' : 'bg-blue-950 text-blue-300 border border-blue-800'}">${rec.system}</span>
                        <span class="block text-xs text-slate-400 mt-0.5">${rec.refrigerant}</span>
                    </td>
                    <td class="py-3 px-2 font-medium text-slate-300">${rec.pipeLength} m</td>
                    <td class="py-3 px-2 font-bold text-emerald-400">${rec.totalFreon} kg</td>
                    <td class="py-3 px-2 text-center space-x-2">
                        <button onclick="loadRecordToForm(${index})" title="Muat ke Form" class="text-blue-400 hover:text-blue-300 transition p-1"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button onclick="deleteRecord(${index})" title="Hapus Data" class="text-rose-400 hover:text-rose-300 transition p-1"><i class="fa-solid fa-trash-can"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        window.deleteRecord = function(index) {
            calculationRecords.splice(index, 1);
            localStorage.setItem('ac_calc_records', JSON.stringify(calculationRecords));
            renderLogs();
            showModal('Data Dihapus', 'Catatan perhitungan telah berhasil dihapus dari sistem.', 'bg-rose-950 text-rose-300 border border-rose-800');
        }

        window.loadRecordToForm = function(index) {
            const rec = calculationRecords[index];
            techInput.value = rec.technician;
            projectInput.value = rec.project;
            dateInput.value = rec.date;
            pipeLengthInput.value = rec.pipeLength;
            refrigerantSelect.value = rec.refrigerant;
            
            // Set radio system
            const radio = document.querySelector(`input[name="ac-system"][value="${rec.system}"]`);
            if(radio) {
                radio.checked = true;
                radio.dispatchEvent(new Event('change'));
            }
            calculateRealtime();
            window.scrollTo({ top: 0, behavior: 'smooth' });
            showModal('Dimuat ke Form', `Data proyek "${rec.project}" siap direvisi.`, 'bg-blue-950 text-blue-300 border border-blue-800');
        }

        // Reset form button
        document.getElementById('btn-reset').addEventListener('click', () => {
            form.reset();
            document.getElementById('refill-date').valueAsDate = new Date();
            document.querySelector('input[name="ac-system"][value="DX"]').checked = true;
            vrvGroupContainer.classList.add('hidden');
            activeSystemTag.innerText = 'Sistem DX';
            activeSystemTag.className = 'bg-blue-950 text-blue-300 border border-blue-800 font-bold text-xs px-3 py-1 rounded-full uppercase';
            calculateRealtime();
        });

        document.getElementById('btn-print-requisition').addEventListener('click', () => {
            const calc = calculateRealtime();
            if(calc.totalFreon <= 0) {
                showModal('Peringatan', 'Harap masukkan data panjang pipa yang valid terlebih dahulu.', 'bg-amber-950 text-amber-300 border border-amber-800');
                return;
            }

            // Populate print template
            document.getElementById('print-doc-id').innerText = 'REQ-' + Math.floor(100000 + Math.random() * 900000);
            document.getElementById('print-technician').innerText = techInput.value || '-';
            document.getElementById('print-project').innerText = projectInput.value || '-';
            document.getElementById('print-date').innerText = dateInput.value || '-';
            document.getElementById('print-system-info').innerText = `${document.querySelector('input[name="ac-system"]:checked').value} (${refrigerantSelect.value})`;
            document.getElementById('print-item-name').innerText = `Refrigerant ${refrigerantSelect.value} (Kebutuhan Pipa: ${calc.pipeLength}m)`;
            document.getElementById('print-item-qty').innerText = calc.totalFreon.toFixed(2);
            document.getElementById('sign-tech').innerText = `(${techInput.value || 'Teknisi'})`;

            window.print();
        });

        // Export CSV handler
        document.getElementById('btn-export-csv').addEventListener('click', () => {
            if(calculationRecords.length === 0) {
                showModal('Peringatan', 'Belum ada data riwayat untuk diexport.', 'bg-amber-950 text-amber-300 border border-amber-800');
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,ID,Teknisi,Proyek,Tanggal,Sistem,Panjang Pipa (m),Refrigerant,Total Freon (kg)\n";
            calculationRecords.forEach(r => {
                csvContent += `"${r.id}","${r.technician}","${r.project}","${r.date}","${r.system}",${r.pipeLength},"${r.refrigerant}",${r.totalFreon}\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", "laporan_kebutuhan_freon_ac.csv");
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        });

        // Custom modal helper
        function showModal(title, message, iconClass = 'bg-emerald-950 text-emerald-400 border border-emerald-800') {
            const modal = document.getElementById('notification-modal');
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-message').innerText = message;
            document.getElementById('modal-icon').className = `w-12 h-12 rounded-full mx-auto flex items-center justify-center text-xl font-bold ${iconClass}`;
            modal.classList.remove('hidden');
        }

        document.getElementById('modal-close-btn').addEventListener('click', () => {
            document.getElementById('notification-modal').classList.add('hidden');
        });

        // Initial run
        renderLogs();
        calculateRealtime();
    </script>
</body>
</html>
